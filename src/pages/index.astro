---
import BaseLayout from "@/layouts/BaseLayout.astro";
import axios from "axios";
const r = await axios.get(`https://api.deezer.com/chart/0`);
---

<BaseLayout pageTitle="Home">
	<main>
		{
			r.data["tracks"]["data"].map(
				(
					e: any, // fix type
				) => (
					<>
						<div class="text-black">{e["title"]}</div>
						<img src={e["album"]["cover_medium"]} />
					</>
				),
			)
		}
	</main>
</BaseLayout>
