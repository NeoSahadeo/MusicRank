---
import SignIn from "@/components/custom/SignIn.svelte";
import type { UserType } from "@/types/user";
import PostRank from "@/components/custom/PostRank.svelte";
import { actions } from "astro:actions";

const user = (Astro.locals.user as UserType).user;

const { data, error } = await Astro.callAction(
	actions.rankactions.getAllRankings,
	{},
);
console.log(data);
---

<SignIn client:load />
<PostRank client:load />

{user && <div>{JSON.stringify(user)}</div>}
