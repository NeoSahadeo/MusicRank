---
import "@/styles/global.css";
import Header from "@/components/layout/header";
import ClientOnlyQueryClientProvider from "@/providers/ClientOnlyQueryClientProvider";

const { pageTitle } = Astro.props;

const user = Astro.locals.user || {};
---

<html lang="en" style="color-scheme: dark;" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header userData={user} client:load />
    <main>
      <div class="flex m-3 flex-col items-center justify-center">
        <ClientOnlyQueryClientProvider client:load>
          <slot />
        </ClientOnlyQueryClientProvider>
      </div>
    </main>
  </body>
</html>
